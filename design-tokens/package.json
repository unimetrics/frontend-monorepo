{
  "name": "@unimetrics/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsx ./scripts/build-tokens/build-tokens.ts",
    "dev": "tsx watch --clear-screen=false --include './tokens/**/*.json' ./scripts/build-tokens/build-tokens.ts",
    "lint": "pnpm lint:artifacts",
    "lint:artifacts": "pnpm build && tsx ./scripts/lint-artifacts/lint-artifacts.ts"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "2.0.3",
    "@types/lodash": "catalog:",
    "lodash": "catalog:",
    "style-dictionary": "5.4.0"
  },
  "peerDependencies": {
    "tailwindcss": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
