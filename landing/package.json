{
  "name": "@unimetrics/landing",
  "version": "0.1.0",
  "private": true,
  "description": "Unimetrics landing app based on AstroWind.",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "pnpm run check:astro && pnpm run check:eslint && pnpm run format",
    "check:astro": "astro check",
    "check:eslint": "pnpm -w exec eslint . --cache",
    "dev": "astro dev",
    "fix": "pnpm run fix:eslint && pnpm run format:fix",
    "fix:eslint": "pnpm -w exec eslint --cache --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier -w .",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.15",
    "@astrojs/sitemap": "3.7.0",
    "@unimetrics/ui": "workspace:*",
    "astro": "5.18.0",
    "astro-embed": "0.12.0",
    "astro-icon": "1.1.5",
    "limax": "4.2.2",
    "lodash.merge": "4.6.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "unpic": "4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/mdx": "4.3.13",
    "@astrojs/partytown": "2.1.4",
    "@astrojs/react": "4.4.2",
    "@iconify-json/flat-color-icons": "1.2.3",
    "@iconify-json/tabler": "1.2.29",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.1",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.merge": "4.6.9",
    "@types/mdx": "2.0.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro-compress": "2.3.9",
    "js-yaml": "4.1.1",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "reading-time": "1.5.0",
    "sharp": "0.34.5",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
