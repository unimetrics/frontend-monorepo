---
import Layout from "~/layouts/Layout.astro";
import { localizeHref } from "~/i18n/links";
import { defaultLocale } from "~/i18n/routing";
import { getHomePermalink } from "~/utils/permalinks";

const title = `Error 404`;
const locale = Astro.currentLocale ?? defaultLocale;
const homePermalink = localizeHref(locale, getHomePermalink());
---

<Layout metadata={{ title }}>
  <section class="flex h-full items-center p-16">
    <div class="container mx-auto my-8 flex flex-col items-center justify-center px-5">
      <div class="max-w-md text-center">
        <h2 class="mb-8 text-9xl font-bold">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">
          Sorry, we couldn't find this page.
        </p>
        <p class="mb-8 mt-4 text-lg text-text-muted dark:text-slate-400">
          But dont worry, you can find plenty of other things on our homepage.
        </p>
        <a
          rel="noopener noreferrer"
          href={homePermalink}
          class="btn ml-4 rtl:ml-0 rtl:mr-4">Back to homepage</a
        >
      </div>
    </div>
  </section>
</Layout>
