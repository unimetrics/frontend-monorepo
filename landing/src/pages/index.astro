---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";

import HeroSection from "~/components/landing/HeroSection.astro";
import ProblemSection from "~/components/landing/ProblemSection.astro";
import FeaturesSection from "~/components/landing/FeaturesSection.astro";
import WorkflowSection from "~/components/landing/WorkflowSection.astro";
import TrustSection from "~/components/landing/TrustSection.astro";
import AudienceSection from "~/components/landing/AudienceSection.astro";
import FaqSection from "~/components/landing/FaqSection.astro";
import BlogSection from "~/components/landing/BlogSection.astro";
import FinalCtaSection from "~/components/landing/FinalCtaSection.astro";

import { getMessages, t } from "~/i18n";
import { getLocaleSwitchLinks, localizeHref } from "~/i18n/links";
import { defaultLocale } from "~/i18n/routing";
import { getFooterData } from "~/navigation";
import { getBlogPermalink } from "~/utils/permalinks";
import { SITE } from "unimetrics:config";

const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const localeLinks = getLocaleSwitchLinks(locale, Astro.url.pathname);
const footerData = getFooterData(locale);

const metadata = {
  title: `${SITE.name} - ${t(messages, "landing.hero.title")}`,
  description: t(messages, "landing.hero.subtitle"),
  ignoreTitleTemplate: true,
};

const heroPills = [1, 2, 3].map(index => t(messages, `landing.hero.pill.${index}`));

const painCards = [1, 2, 3, 4].map(index => ({
  title: t(messages, `landing.problem.card.${index}.title`),
  text: t(messages, `landing.problem.card.${index}.body`),
}));

const featureCards = [1, 2, 3, 4].map(index => ({
  title: t(messages, `landing.features.card.${index}.title`),
  text: t(messages, `landing.features.card.${index}.body`),
}));

const workflowSteps = [1, 2, 3].map(index => ({
  title: t(messages, `landing.workflow.step.${index}.title`),
  text: t(messages, `landing.workflow.step.${index}.body`),
}));

const trustPoints = [1, 2, 3].map(index => ({
  title: t(messages, `landing.trust.point.${index}.title`),
  text: t(messages, `landing.trust.point.${index}.body`),
}));

const audienceCards = [1, 2, 3].map(index => ({
  title: t(messages, `landing.audience.card.${index}.title`),
  text: t(messages, `landing.audience.card.${index}.body`),
}));

const faqItems = [1, 2, 3, 4].map(index => ({
  question: t(messages, `landing.faq.item.${index}.question`),
  answer: t(messages, `landing.faq.item.${index}.answer`),
}));

const navLinks = [
  { href: "#problem", text: t(messages, "landing.nav.problem") },
  { href: "#features", text: t(messages, "landing.nav.features") },
  { href: "#workflow", text: t(messages, "landing.nav.workflow") },
  { href: "#faq", text: t(messages, "landing.nav.faq") },
  {
    href: localizeHref(locale, getBlogPermalink()),
    text: t(messages, "footer.link.blog"),
  },
  { href: "#contact", text: t(messages, "landing.nav.access") },
];

const headerActions = [
  { href: "#contact", text: t(messages, "landing.header.cta.requestAccess") },
];

const contactHref = "mailto:founders@example.com";
---

<Layout metadata={metadata}>
  <div
    class="relative min-h-screen overflow-hidden bg-[radial-gradient(circle_at_12%_18%,rgba(216,185,122,0.12),transparent_28%),radial-gradient(circle_at_88%_22%,rgba(92,118,154,0.16),transparent_30%),radial-gradient(circle_at_52%_100%,rgba(53,80,112,0.22),transparent_36%),linear-gradient(180deg,#061018_0%,#07131d_52%,#050d15_100%)] text-white"
  >
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute left-[-8rem] top-24 h-72 w-72 rounded-full bg-amber-300/10 blur-3xl"
      >
      </div>
      <div
        class="absolute right-[-4rem] top-16 h-80 w-80 rounded-full bg-slate-400/10 blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-[-5rem] left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-blue-400/10 blur-3xl"
      >
      </div>
    </div>

    <Header
      links={navLinks}
      actions={headerActions}
      localeLinks={localeLinks}
      localeSwitcherAriaLabel={t(messages, "header.aria.languageSwitcher")}
      mainNavigationAriaLabel={t(messages, "header.aria.mainNavigation")}
      isDark
      position="right"
      variant="landing"
    />

    <main id="top">
      <HeroSection messages={messages} heroPills={heroPills} />
      <ProblemSection messages={messages} painCards={painCards} />
      <FeaturesSection messages={messages} featureCards={featureCards} />
      <WorkflowSection messages={messages} workflowSteps={workflowSteps} />
      <TrustSection messages={messages} trustPoints={trustPoints} />
      <AudienceSection messages={messages} audienceCards={audienceCards} />
      <FaqSection messages={messages} faqItems={faqItems} />
      <BlogSection messages={messages} />
      <FinalCtaSection messages={messages} contactHref={contactHref} />
    </main>

    <div id="landing-footer" class="relative mt-4">
      <Footer {...footerData} theme="dark" />
    </div>
  </div>

  <script>
    const prefersReducedMotion = globalThis.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const revealItems = [...document.querySelectorAll("[data-reveal]")];

    if (prefersReducedMotion) {
      for (const item of revealItems) {
        item.classList.add("is-visible");
      }
    } else {
      const observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) {
              continue;
            }

            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        {
          rootMargin: "0px 0px -10% 0px",
          threshold: 0.15,
        }
      );

      for (const [index, item] of revealItems.entries()) {
        item.setAttribute("style", `transition-delay:${Math.min(index * 40, 240)}ms`);
        observer.observe(item);
      }
    }
  </script>

  <style>
    [data-reveal] {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.7s ease,
        transform 0.7s ease;
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    #landing-footer footer {
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(4, 11, 18, 0.72);
      backdrop-filter: blur(10px);
    }
  </style>
</Layout>
