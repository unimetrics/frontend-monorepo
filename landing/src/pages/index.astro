---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";

import HeroSection from "~/components/landing/HeroSection.astro";
import ProblemSection from "~/components/landing/ProblemSection.astro";
import FeaturesSection from "~/components/landing/FeaturesSection.astro";
import WorkflowSection from "~/components/landing/WorkflowSection.astro";
import TrustSection from "~/components/landing/TrustSection.astro";
import AudienceSection from "~/components/landing/AudienceSection.astro";
import FaqSection from "~/components/landing/FaqSection.astro";
import BlogSection from "~/components/landing/BlogSection.astro";
import FinalCtaSection from "~/components/landing/FinalCtaSection.astro";

import { getMessages, t } from "~/i18n";
import { getLocaleSwitchLinks, localizeHref } from "~/i18n/links";
import { defaultLocale } from "~/i18n/routing";
import { getFooterData } from "~/navigation";
import { getBlogPermalink } from "~/utils/permalinks";
import { SITE } from "unimetrics:config";

const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const localeLinks = getLocaleSwitchLinks(locale, Astro.url.pathname);
const footerData = getFooterData(locale);

const metadata = {
  title: `${SITE.name} - ${t(messages, "landing.hero.title")}`,
  description: t(messages, "landing.hero.subtitle"),
  ignoreTitleTemplate: true,
};

const heroPills = [1, 2, 3].map(index => t(messages, `landing.hero.pill.${index}`));

const painCards = [1, 2, 3, 4].map(index => ({
  title: t(messages, `landing.problem.card.${index}.title`),
  text: t(messages, `landing.problem.card.${index}.body`),
}));

const featureCards = [1, 2, 3, 4].map(index => ({
  title: t(messages, `landing.features.card.${index}.title`),
  text: t(messages, `landing.features.card.${index}.body`),
}));

const workflowSteps = [1, 2, 3].map(index => ({
  title: t(messages, `landing.workflow.step.${index}.title`),
  text: t(messages, `landing.workflow.step.${index}.body`),
}));

const trustPoints = [1, 2, 3].map(index => ({
  title: t(messages, `landing.trust.point.${index}.title`),
  text: t(messages, `landing.trust.point.${index}.body`),
}));

const audienceCards = [1, 2, 3].map(index => ({
  title: t(messages, `landing.audience.card.${index}.title`),
  text: t(messages, `landing.audience.card.${index}.body`),
}));

const faqItems = [1, 2, 3, 4].map(index => ({
  question: t(messages, `landing.faq.item.${index}.question`),
  answer: t(messages, `landing.faq.item.${index}.answer`),
}));

const navLinks = [
  { href: "#problem", text: t(messages, "landing.nav.problem") },
  { href: "#features", text: t(messages, "landing.nav.features") },
  { href: "#workflow", text: t(messages, "landing.nav.workflow") },
  { href: "#faq", text: t(messages, "landing.nav.faq") },
  {
    href: localizeHref(locale, getBlogPermalink()),
    text: t(messages, "footer.link.blog"),
  },
  { href: "#contact", text: t(messages, "landing.nav.access") },
];

const headerActions = [
  { href: "#contact", text: t(messages, "landing.header.cta.requestAccess") },
];

const contactHref = "mailto:founders@example.com";
---

<Layout metadata={metadata}>
  <div
    class="relative min-h-screen overflow-hidden bg-[radial-gradient(circle_at_12%_18%,rgba(216,185,122,0.12),transparent_28%),radial-gradient(circle_at_88%_22%,rgba(92,118,154,0.16),transparent_30%),radial-gradient(circle_at_52%_100%,rgba(53,80,112,0.22),transparent_36%),linear-gradient(180deg,#061018_0%,#07131d_52%,#050d15_100%)] text-white"
  >
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        data-parallax-speed="0.18"
        class="absolute left-[-8rem] top-24 h-72 w-72 rounded-full bg-amber-300/10 blur-3xl"
      >
      </div>
      <div
        data-parallax-speed="-0.12"
        class="absolute right-[-4rem] top-16 h-80 w-80 rounded-full bg-slate-400/10 blur-3xl"
      >
      </div>
      <div
        data-parallax-speed="0.24"
        class="absolute bottom-[-5rem] left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-blue-400/10 blur-3xl"
      >
      </div>
    </div>

    <Header
      links={navLinks}
      actions={headerActions}
      localeLinks={localeLinks}
      localeSwitcherAriaLabel={t(messages, "header.aria.languageSwitcher")}
      mainNavigationAriaLabel={t(messages, "header.aria.mainNavigation")}
      isDark
      position="right"
      variant="landing"
    />

    <main id="top">
      <HeroSection messages={messages} heroPills={heroPills} />
      <ProblemSection messages={messages} painCards={painCards} />
      <FeaturesSection messages={messages} featureCards={featureCards} />
      <WorkflowSection messages={messages} workflowSteps={workflowSteps} />
      <TrustSection messages={messages} trustPoints={trustPoints} />
      <AudienceSection messages={messages} audienceCards={audienceCards} />
      <FaqSection messages={messages} faqItems={faqItems} />
      <BlogSection messages={messages} />
      <FinalCtaSection messages={messages} contactHref={contactHref} />
    </main>

    <div id="landing-footer" class="relative mt-4">
      <Footer {...footerData} theme="dark" />
    </div>
  </div>

  <script>
    import { gsap, ScrollTrigger } from "~/utils/gsap";

    type RevealAnimation = {
      from: gsap.TweenVars;
      to: gsap.TweenVars;
    };

    type RevealVariant =
      | "badge"
      | "callout"
      | "card"
      | "chips"
      | "copy"
      | "cta"
      | "cta-card"
      | "default"
      | "metrics"
      | "panel"
      | "step"
      | "title";

    const getRevealAnimation = (element: HTMLElement, index: number): RevealAnimation => {
      const variant = (element.dataset.reveal || "default") as RevealVariant;
      const direction = index % 2 === 0 ? -1 : 1;
      const baseTo: gsap.TweenVars = {
        autoAlpha: 1,
        clearProps: "opacity,transform,visibility,filter,clipPath,willChange",
      };

      switch (variant) {
        case "badge": {
          return {
            from: {
              autoAlpha: 0,
              filter: "blur(8px)",
              scale: 0.92,
              y: 18,
            },
            to: {
              ...baseTo,
              duration: 0.65,
              ease: "back.out(1.75)",
              filter: "blur(0px)",
              scale: 1,
              y: 0,
            },
          };
        }
        case "callout": {
          return {
            from: { autoAlpha: 0, filter: "blur(10px)", scale: 0.94, y: 28 },
            to: {
              ...baseTo,
              duration: 0.86,
              ease: "expo.out",
              filter: "blur(0px)",
              scale: 1,
              y: 0,
            },
          };
        }
        case "card": {
          return {
            from: {
              autoAlpha: 0,
              filter: "blur(9px)",
              rotateX: -8,
              scale: 0.96,
              transformPerspective: 1000,
              x: direction * 20,
              y: 40,
            },
            to: {
              ...baseTo,
              duration: 0.88,
              ease: "power3.out",
              filter: "blur(0px)",
              rotateX: 0,
              scale: 1,
              x: 0,
              y: 0,
            },
          };
        }
        case "chips": {
          return {
            from: {
              autoAlpha: 0,
              filter: "blur(8px)",
              rotateX: -14,
              transformPerspective: 900,
              y: 30,
            },
            to: {
              ...baseTo,
              duration: 0.78,
              ease: "power3.out",
              filter: "blur(0px)",
              rotateX: 0,
              y: 0,
            },
          };
        }
        case "copy": {
          return {
            from: { autoAlpha: 0, filter: "blur(8px)", y: 32 },
            to: {
              ...baseTo,
              duration: 0.78,
              ease: "power3.out",
              filter: "blur(0px)",
              y: 0,
            },
          };
        }
        case "cta": {
          return {
            from: { autoAlpha: 0, scale: 0.95, y: 26 },
            to: {
              ...baseTo,
              duration: 0.74,
              ease: "power3.out",
              scale: 1,
              y: 0,
            },
          };
        }
        case "cta-card": {
          return {
            from: { autoAlpha: 0, filter: "blur(14px)", scale: 0.94, y: 66 },
            to: {
              ...baseTo,
              duration: 1.08,
              ease: "power4.out",
              filter: "blur(0px)",
              scale: 1,
              y: 0,
            },
          };
        }
        case "metrics": {
          return {
            from: { autoAlpha: 0, filter: "blur(9px)", scale: 0.96, y: 34 },
            to: {
              ...baseTo,
              duration: 0.82,
              ease: "power3.out",
              filter: "blur(0px)",
              scale: 1,
              y: 0,
            },
          };
        }
        case "panel": {
          return {
            from: {
              autoAlpha: 0,
              filter: "blur(12px)",
              rotateY: -10,
              scale: 0.96,
              transformPerspective: 1200,
              x: 74,
            },
            to: {
              ...baseTo,
              duration: 1.05,
              ease: "power4.out",
              filter: "blur(0px)",
              rotateY: 0,
              scale: 1,
              x: 0,
            },
          };
        }
        case "step": {
          return {
            from: {
              autoAlpha: 0,
              filter: "blur(9px)",
              scale: 0.95,
              x: direction * 38,
              y: 24,
            },
            to: {
              ...baseTo,
              duration: 0.9,
              ease: "power3.out",
              filter: "blur(0px)",
              scale: 1,
              x: 0,
              y: 0,
            },
          };
        }
        case "title": {
          return {
            from: {
              autoAlpha: 0,
              clipPath: "inset(0 0 100% 0)",
              filter: "blur(10px)",
              y: 64,
            },
            to: {
              ...baseTo,
              clipPath: "inset(0 0 0% 0)",
              duration: 0.95,
              ease: "power4.out",
              filter: "blur(0px)",
              y: 0,
            },
          };
        }
        default: {
          return {
            from: { autoAlpha: 0, filter: "blur(8px)", y: 26 },
            to: {
              ...baseTo,
              duration: 0.76,
              ease: "power2.out",
              filter: "blur(0px)",
              y: 0,
            },
          };
        }
      }
    };

    const clearRevealStyles = (element: HTMLElement) => {
      element.style.removeProperty("opacity");
      element.style.removeProperty("transform");
      element.style.removeProperty("visibility");
      element.style.removeProperty("filter");
      element.style.removeProperty("clip-path");
      element.style.removeProperty("will-change");
    };

    let revealContext: gsap.Context | undefined;

    const setupRevealAnimations = () => {
      revealContext?.revert();
      revealContext = undefined;

      const revealItems = gsap.utils.toArray<HTMLElement>("[data-reveal]");
      const parallaxItems = gsap.utils.toArray<HTMLElement>("[data-parallax-speed]");
      if (revealItems.length === 0 && parallaxItems.length === 0) {
        return;
      }

      const prefersReducedMotion = globalThis.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (prefersReducedMotion) {
        for (const item of revealItems) {
          clearRevealStyles(item);
        }
        return;
      }

      revealContext = gsap.context(() => {
        for (const [index, item] of revealItems.entries()) {
          const animation = getRevealAnimation(item, index);
          gsap.set(item, {
            ...animation.from,
            willChange: "opacity, transform, filter",
          });

          ScrollTrigger.create({
            once: true,
            onEnter: () => {
              gsap.to(item, animation.to);
            },
            start: "top 87%",
            trigger: item,
          });
        }

        for (const item of parallaxItems) {
          const speed = Number.parseFloat(item.dataset.parallaxSpeed ?? "0");
          if (!Number.isFinite(speed) || speed === 0) {
            continue;
          }

          gsap.to(item, {
            ease: "none",
            scrollTrigger: {
              end: "bottom bottom",
              scrub: 0.8,
              start: "top top",
              trigger: document.body,
            },
            yPercent: speed * 100,
          });
        }
      }, document.body);
    };

    const setupState = globalThis as typeof globalThis & {
      __unimetricsLandingRevealInitialized__?: boolean;
    };

    if (!setupState.__unimetricsLandingRevealInitialized__) {
      document.addEventListener("astro:after-swap", setupRevealAnimations);
      document.addEventListener("astro:before-swap", () => {
        revealContext?.revert();
        revealContext = undefined;
      });
      setupState.__unimetricsLandingRevealInitialized__ = true;
    }

    setupRevealAnimations();
  </script>

  <style>
    #landing-footer footer {
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(4, 11, 18, 0.72);
      backdrop-filter: blur(10px);
    }
  </style>
</Layout>
