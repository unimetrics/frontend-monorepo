---
import { Icon } from "astro-icon/components";
import Logo from "~/components/Logo.astro";
import ToggleTheme from "~/components/common/ToggleTheme.astro";
import ToggleMenu from "~/components/common/ToggleMenu.astro";
import Button from "~/components/ui/Button.astro";

import { getHomePermalink } from "~/utils/permalinks";
import { trimSlash, getAsset } from "~/utils/permalinks";
import { localizeHref } from "~/i18n/links";
import { defaultLocale } from "~/i18n/routing";
import type { CallToAction } from "~/types";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

interface LocaleLink {
  href: string;
  isCurrent: boolean;
  label: string;
  locale: string;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  localeLinks?: Array<LocaleLink>;
  localeSwitcherAriaLabel?: string;
  mainNavigationAriaLabel?: string;
  rssAriaLabel?: string;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  variant?: "default" | "landing";
}

const {
  id = "header",
  links = [],
  localeLinks = [],
  localeSwitcherAriaLabel = "Language switcher",
  mainNavigationAriaLabel = "Main navigation",
  rssAriaLabel = "RSS feed",
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = "center",
  variant = "default",
} = Astro.props;

const currentLocale = Astro.currentLocale ?? defaultLocale;
const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const homeHref = localizeHref(currentLocale, getHomePermalink());
const isLanding = variant === "landing";
---

<header
  class:list={[
    isLanding
      ? "sticky top-0 z-40 mx-auto w-full flex-none border-b border-white/10 bg-[#061018]/70 backdrop-blur-xl"
      : "top-0 z-40 mx-auto w-full flex-none border-b border-gray-50/0 transition-[opacity] ease-in-out",
    !isLanding && { sticky: isSticky, relative: !isSticky, dark: isDark },
    isLanding && { dark: isDark },
  ]}
  {...!isLanding && isSticky ? { "data-aw-sticky-header": true } : {}}
  {...id ? { id } : {}}
>
  {!isLanding && <div class="absolute inset-0" />}
  <div
    class:list={[
      isLanding
        ? "mx-auto flex min-h-20 w-full max-w-7xl items-center justify-between gap-6 px-5 text-white sm:px-8 lg:px-10"
        : "relative mx-auto w-full px-3 py-3 text-text-default md:px-6",
      !isLanding && {
        "md:flex md:justify-between": position !== "center",
      },
      !isLanding && {
        "md:grid md:grid-cols-3 md:items-center": position === "center",
      },
      !isLanding && {
        "max-w-7xl": !isFullWidth,
      },
    ]}
  >
    <div
      class:list={[
        isLanding ? "flex items-center justify-between" : "flex justify-between",
        !isLanding && { "mr-auto rtl:ml-auto rtl:mr-0": position === "right" },
      ]}
    >
      <a
        class:list={["flex items-center", isLanding ? "text-white" : ""]}
        href={homeHref}
      >
        <Logo />
      </a>
      {
        !isLanding && (
          <div class="flex items-center md:hidden">
            <ToggleMenu />
          </div>
        )
      }
    </div>
    <nav
      class:list={[
        isLanding
          ? "hidden items-center text-sm text-white/65 lg:flex"
          : "hidden w-full items-center overflow-y-auto overflow-x-hidden text-text-default md:mx-5 md:flex md:w-auto md:justify-self-center md:overflow-x-auto md:overflow-y-visible",
      ]}
      aria-label={mainNavigationAriaLabel}
    >
      <ul
        class:list={[
          isLanding
            ? "flex items-center gap-7"
            : "flex w-full flex-col text-xl font-medium tracking-[0.01rem] md:w-auto md:flex-row md:justify-center md:self-center md:text-[0.9375rem]",
        ]}
      >
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? "dropdown" : ""}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class:list={[
                      isLanding
                        ? "flex items-center whitespace-nowrap transition hover:text-white"
                        : "hover:text-link flex items-center whitespace-nowrap px-4 py-3 dark:hover:text-white",
                    ]}
                  >
                    {text}{" "}
                    <Icon
                      name="tabler:chevron-down"
                      class:list={[
                        isLanding
                          ? "ml-1 inline h-3.5 w-3.5 rtl:ml-0 rtl:mr-1"
                          : "ml-0.5 hidden h-3.5 w-3.5 md:inline rtl:ml-0 rtl:mr-0.5",
                      ]}
                    />
                  </button>
                  <ul
                    class:list={[
                      isLanding
                        ? "dropdown-menu rounded-xl border border-white/10 bg-[#07131d] p-2 text-sm md:absolute md:hidden md:min-w-[220px]"
                        : "dropdown-menu dark:md:bg-dark rounded pl-4 font-medium drop-shadow-xl md:absolute md:hidden md:min-w-[200px] md:bg-white/90 md:pl-0 md:backdrop-blur-md rtl:pl-0 rtl:pr-4 md:rtl:pr-0",
                    ]}
                  >
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            isLanding
                              ? "block whitespace-nowrap rounded-lg px-4 py-2 text-white/75 transition hover:bg-white/10 hover:text-white"
                              : "hover:text-link whitespace-no-wrap block px-5 py-2 first:rounded-t last:rounded-b dark:hover:bg-gray-700 dark:hover:text-white md:hover:bg-gray-100",
                            !isLanding && { "aw-link-active": href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    isLanding
                      ? "flex items-center whitespace-nowrap transition hover:text-white"
                      : "hover:text-link flex items-center whitespace-nowrap px-4 py-3 dark:hover:text-white",
                    !isLanding && { "aw-link-active": href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        isLanding
          ? "hidden items-center gap-3 sm:flex"
          : "fixed bottom-0 left-0 hidden w-full items-center justify-end p-3 md:static md:mb-0 md:flex md:w-auto md:self-center md:justify-self-end md:p-0 rtl:left-auto rtl:right-0",
        !isLanding && { "ml-auto rtl:ml-0 rtl:mr-auto": position === "left" },
      ]}
    >
      <div
        class:list={[
          isLanding
            ? "flex items-center gap-3"
            : "flex w-full items-center justify-between md:w-auto",
        ]}
      >
        <div class="flex">
          {
            localeLinks.length > 0 && (
              <nav
                aria-label={localeSwitcherAriaLabel}
                class:list={[
                  isLanding
                    ? "hidden sm:block"
                    : "mr-1 hidden md:block rtl:mr-0 rtl:ml-1",
                ]}
              >
                <ul class="flex items-center gap-1">
                  {localeLinks.map(({ href, isCurrent, label, locale }) => (
                    <li>
                      <a
                        href={href}
                        hreflang={locale}
                        aria-current={isCurrent ? "page" : undefined}
                        class:list={[
                          "inline-flex rounded-md px-2 py-1 text-xs font-semibold transition",
                          isLanding
                            ? isCurrent
                              ? "bg-white/20 text-white"
                              : "text-white/60 hover:bg-white/10 hover:text-white"
                            : isCurrent
                              ? "bg-gray-200 text-text-default dark:bg-gray-700 dark:text-white"
                              : "text-text-muted hover:bg-gray-100 hover:text-text-default dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white",
                        ]}
                      >
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          {
            showToggleTheme && (
              <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />
            )
          }
          {
            showRssFeed && (
              <a
                class="inline-flex items-center rounded-lg p-2.5 text-sm text-text-muted hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-700"
                aria-label={rssAriaLabel}
                href={getAsset("/rss.xml")}
              >
                <Icon name="tabler:rss" class="h-5 w-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class:list={[isLanding ? "" : "ml-4 rtl:ml-0 rtl:mr-4"]}>
              {actions.map(btnProps => (
                <Button
                  {...btnProps}
                  class={
                    isLanding
                      ? "ml-2 !inline-flex !min-h-12 !w-auto !items-center !justify-center !rounded-full !border-white/15 !bg-white/5 !px-5 !py-2.5 !text-sm !font-semibold !text-white !shadow-none transition duration-200 hover:!-translate-y-0.5 hover:!bg-white/10 rtl:ml-0 rtl:mr-2"
                      : "px-5.5 ml-2 w-auto py-2.5 text-sm font-semibold shadow-none md:px-6 rtl:ml-0 rtl:mr-2"
                  }
                />
              ))}
            </span>
          ) : (
            ""
          )
        }
      </div>
    </div>
  </div>
</header>
