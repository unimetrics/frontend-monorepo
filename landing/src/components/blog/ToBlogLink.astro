---
import { Icon } from "astro-icon/components";
import { getBlogPermalink } from "~/utils/permalinks";
import Button from "~/components/ui/Button.astro";
import { getMessages, t } from "~/i18n";
import { localizeHref } from "~/i18n/links";
import { defaultLocale, getLocaleDirection } from "~/i18n/routing";

const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const textDirection = getLocaleDirection(locale);
const blogPermalink = localizeHref(locale, getBlogPermalink());
---

<div class="mx-auto max-w-3xl px-6 pb-12 pt-8 sm:px-6 md:pb-20 md:pt-4">
  <Button variant="tertiary" class="px-3 md:px-3" href={blogPermalink}>
    {
      textDirection === "rtl" ? (
        <Icon
          name="tabler:chevron-right"
          class="-ml-1.5 mr-1 h-5 w-5 rtl:-mr-1.5 rtl:ml-1"
        />
      ) : (
        <Icon
          name="tabler:chevron-left"
          class="-ml-1.5 mr-1 h-5 w-5 rtl:-mr-1.5 rtl:ml-1"
        />
      )
    }
    {t(messages, "blog.backToBlog")}
  </Button>
</div>
