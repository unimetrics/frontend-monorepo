---
import type { Messages } from "~/i18n";
import { t } from "~/i18n";

import type { ContentCard } from "~/components/landing/types";

interface Props {
  messages: Messages;
  trustPoints: ContentCard[];
}

const { messages, trustPoints } = Astro.props;
---

<section class="py-20 sm:py-24 lg:py-28">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 lg:px-10">
    <div
      class="grid gap-5 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:items-start"
    >
      <article
        data-reveal="panel"
        class="rounded-[2rem] border border-amber-200/12 bg-[linear-gradient(180deg,rgba(216,185,122,0.08),rgba(255,255,255,0.02))] p-7 sm:p-8"
      >
        <div
          class="inline-flex items-center gap-2 rounded-full border border-amber-200/15 bg-amber-200/10 px-4 py-2 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-[#f5e2b5]"
        >
          {t(messages, "landing.trust.eyebrow")}
        </div>
        <h2 class="mt-6 text-3xl font-semibold tracking-[-0.03em] text-white sm:text-4xl">
          {t(messages, "landing.trust.title")}
        </h2>
        <p class="mt-4 text-base leading-8 text-white/72 sm:text-lg">
          {t(messages, "landing.trust.body")}
        </p>
      </article>

      <div class="grid gap-5">
        {
          trustPoints.map(item => (
            <article
              data-reveal="card"
              class="rounded-[1.75rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.015))] p-6 shadow-[var(--shadow-inset)]"
            >
              <h3 class="text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-white/65">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
