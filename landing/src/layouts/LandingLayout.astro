---
import PageLayout from "~/layouts/PageLayout.astro";
import Header from "~/components/widgets/Header.astro";

import { getMessages, t } from "~/i18n";
import { getLocaleSwitchLinks } from "~/i18n/links";
import { defaultLocale } from "~/i18n/routing";
import { getHeaderData } from "~/navigation";
import type { MetaData } from "~/types";

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const headerData = getHeaderData(locale);
const localeLinks = getLocaleSwitchLinks(locale, Astro.url.pathname);
---

<PageLayout metadata={metadata}>
  <Fragment slot="announcement">
    <slot name="announcement" />
  </Fragment>
  <Fragment slot="header">
    <slot name="header">
      <Header
        links={headerData?.links[2] ? [headerData.links[2]] : undefined}
        actions={[
          {
            text: t(messages, "header.action.download"),
            href: "https://github.com/unimetrics/frontend-monorepo",
          },
        ]}
        localeLinks={localeLinks}
        localeSwitcherAriaLabel={t(messages, "header.aria.languageSwitcher")}
        mainNavigationAriaLabel={t(messages, "header.aria.mainNavigation")}
        showToggleTheme
        position="right"
      />
    </slot>
  </Fragment>
  <slot />
</PageLayout>
