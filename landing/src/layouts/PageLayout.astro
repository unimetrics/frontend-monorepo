---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";

import { getMessages, t } from "~/i18n";
import { getLocaleSwitchLinks } from "~/i18n/links";
import { defaultLocale } from "~/i18n/routing";
import { getFooterData, getHeaderData } from "~/navigation";

import type { MetaData } from "~/types";

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const headerData = getHeaderData(locale);
const footerData = getFooterData(locale);
const localeLinks = getLocaleSwitchLinks(locale, Astro.url.pathname);
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header
      {...headerData}
      isSticky
      localeLinks={localeLinks}
      localeSwitcherAriaLabel={t(messages, "header.aria.languageSwitcher")}
      mainNavigationAriaLabel={t(messages, "header.aria.mainNavigation")}
      rssAriaLabel={t(messages, "header.aria.rssFeed")}
      showRssFeed
      showToggleTheme
    />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
