{
  "name": "@unimetrics/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "pnpm run build:tokens",
    "build:tokens": "tsx ./scripts/build-tokens/build-tokens.ts",
    "dev": "tsx watch --clear-screen=false --include './tokens/**/*.json' --exclude './tokens/generated/**' --exclude './tokens.css' --exclude './theme.css' ./scripts/build-tokens/build-tokens.ts"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "2.0.3",
    "change-case": "5.4.4",
    "style-dictionary": "5.3.3"
  },
  "peerDependencies": {
    "tailwindcss": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
