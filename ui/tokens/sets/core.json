{
  "border": {
    "width": {
      "regular": {
        "$type": "dimension",
        "$value": "2px"
      },
      "thin": {
        "$type": "dimension",
        "$value": "1px"
      }
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": "{font.family.sans}"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, monospace"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "\"Inter Variable\", ui-sans-serif, system-ui, sans-serif"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "\"Inter Variable\", ui-serif, Georgia, serif"
      }
    },
    "lineHeight": {
      "normal": {
        "$type": "lineHeight",
        "$value": "1.5"
      },
      "relaxed": {
        "$type": "lineHeight",
        "$value": "1.7"
      },
      "tight": {
        "$type": "lineHeight",
        "$value": "1.2"
      }
    },
    "size": {
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "1.875rem"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "2.25rem"
      },
      "5xl": {
        "$type": "dimension",
        "$value": "3rem"
      },
      "6xl": {
        "$type": "dimension",
        "$value": "3.75rem"
      },
      "base": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem"
      }
    },
    "weight": {
      "bold": {
        "$type": "fontWeight",
        "$value": "700"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500"
      },
      "regular": {
        "$type": "fontWeight",
        "$value": "400"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "600"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "normal": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      }
    }
  },
