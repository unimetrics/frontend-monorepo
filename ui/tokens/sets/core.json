          "$type": "color",
          "$value": "#e6e6fa"
        }
      },
      "neutral": {
        "100": {
          "$type": "color",
          "$value": "#e5ecf6"
        },
        "300": {
          "$type": "color",
          "$value": "#f7f8f8"
        },
        "900": {
          "$type": "color",
