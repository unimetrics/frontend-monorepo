      "$type": "boxShadow",
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.03)"
    },
    "insetStrong": {
      "$type": "boxShadow",
      "$value": "inset 0 1px 1px rgba(255, 255, 255, 0.35)"
    },
    "md": {
      "$type": "boxShadow",
      "$value": "0 8px 24px rgb(0 0 0 / 0.16)"
    },
    "ribbon": {
      "$type": "boxShadow",
      "$value": "0 3px 10px -5px rgba(0, 0, 0, 0.3)"
    },
    "sm": {
      "$type": "boxShadow",
      "$value": "0 1px 2px rgb(0 0 0 / 0.08)"
    },
    "xl": {
      "$type": "boxShadow",
      "$value": "0 24px 80px rgba(0, 0, 0, 0.35)"
    }
  },
