  "primitive": {
    "color": {
      "gold": {
        "200": {
          "$type": "color",
          "$value": "#f3e2bd"
        },
        "500": {
          "$type": "color",
          "$value": "#d8b97a"
        }
      },
      "neutral": {
        "100": {
          "$type": "color",
          "$value": "#e5ecf6"
        },
        "900": {
          "$type": "color",
          "$value": "rgb(229 236 246 / 66%)"
        }
      },
      "night": {
        "900": {
          "$type": "color",
          "$value": "#050d15"
        }
      },
      "steel": {
        "500": {
          "$type": "color",
          "$value": "#5c769a"
        },
        "600": {
          "$type": "color",
          "$value": "#355070"
        }
