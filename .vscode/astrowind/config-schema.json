{
  "properties": {
    "analytics": {
      "properties": {
        "vendors": {
          "properties": {
            "googleAnalytics": {
              "properties": {
                "id": {
                  "type": ["string", "null"]
                },
                "partytown": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": ["id"],
              "type": "object"
            }
          },
          "required": ["googleAnalytics"],
          "type": "object"
        }
      },
      "required": ["vendors"],
      "type": "object"
    },
    "apps": {
      "properties": {
        "blog": {
          "properties": {
            "category": {
              "properties": {
                "isEnabled": {
                  "type": "boolean"
                },
                "pathname": {
                  "type": "string"
                },
                "robots": {
                  "properties": {
                    "follow": {
                      "type": "boolean"
                    },
                    "index": {
                      "type": "boolean"
                    }
                  },
                  "required": ["index"],
                  "type": "object"
                }
              },
              "required": ["isEnabled", "pathname", "robots"],
              "type": "object"
            },
            "isEnabled": {
              "type": "boolean"
            },
            "isRelatedPostsEnabled": {
              "type": "boolean"
            },
            "list": {
              "properties": {
                "isEnabled": {
                  "type": "boolean"
                },
                "pathname": {
                  "type": "string"
                },
                "robots": {
                  "properties": {
                    "follow": {
                      "type": "boolean"
                    },
                    "index": {
                      "type": "boolean"
                    }
                  },
                  "required": ["index"],
                  "type": "object"
                }
              },
              "required": ["isEnabled", "pathname", "robots"],
              "type": "object"
            },
            "post": {
              "properties": {
                "isEnabled": {
                  "type": "boolean"
                },
                "permalink": {
                  "type": "string"
                },
                "robots": {
                  "properties": {
                    "follow": {
                      "type": "boolean"
                    },
                    "index": {
                      "type": "boolean"
                    }
                  },
                  "required": ["index"],
                  "type": "object"
                }
              },
              "required": ["isEnabled", "permalink", "robots"],
              "type": "object"
            },
            "postsPerPage": {
              "type": "integer"
            },
            "relatedPostsCount": {
              "type": "integer"
            },
            "tag": {
              "properties": {
                "isEnabled": {
                  "type": "boolean"
                },
                "pathname": {
                  "type": "string"
                },
                "robots": {
                  "properties": {
                    "follow": {
                      "type": "boolean"
                    },
                    "index": {
                      "type": "boolean"
                    }
                  },
                  "required": ["index"],
                  "type": "object"
                }
              },
              "required": ["isEnabled", "pathname", "robots"],
              "type": "object"
            }
          },
          "required": [
            "isEnabled",
            "postsPerPage",
            "post",
            "list",
            "category",
            "tag"
          ],
          "type": "object"
        }
      },
      "required": ["blog"],
      "type": "object"
    },
    "i18n": {
      "properties": {
        "language": {
          "type": "string"
        },
        "textDirection": {
          "type": "string"
        }
      },
      "required": ["language", "textDirection"],
      "type": "object"
    },
    "metadata": {
      "properties": {
        "description": {
          "type": "string"
        },
        "openGraph": {
          "properties": {
            "images": {
              "items": [
                {
                  "properties": {
                    "height": {
                      "type": "integer"
                    },
                    "url": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer"
                    }
                  },
                  "required": ["url", "width", "height"],
                  "type": "object"
                }
              ],
              "type": "array"
            },
            "site_name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": ["site_name", "images", "type"],
          "type": "object"
        },
        "robots": {
          "properties": {
            "follow": {
              "type": "boolean"
            },
            "index": {
              "type": "boolean"
            }
          },
          "required": ["index", "follow"],
          "type": "object"
        },
        "title": {
          "properties": {
            "default": {
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          },
          "required": ["default", "template"],
          "type": "object"
        },
        "twitter": {
          "properties": {
            "cardType": {
              "type": "string"
            },
            "handle": {
              "type": "string"
            },
            "site": {
              "type": "string"
            }
          },
          "required": ["handle", "site", "cardType"],
          "type": "object"
        }
      },
      "required": ["title", "description", "robots", "openGraph", "twitter"],
      "type": "object"
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string"
        },
        "googleSiteVerificationId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "trailingSlash": {
          "type": "boolean"
        }
      },
      "required": ["name", "site", "base", "trailingSlash"],
      "type": "object"
    },
    "ui": {
      "properties": {
        "theme": {
          "type": "string"
        }
      },
      "required": ["theme"],
      "type": "object"
    }
  },
  "required": [
    "site",
    "metadata",
    "i18n",
    "apps",
    "analytics",
    "ui"
  ],
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
