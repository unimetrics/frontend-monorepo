{
  "name": "frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "pnpm --filter @unimetrics/mobile android",
    "api:build": "pnpm --filter @unimetrics/api build",
    "api:lint": "pnpm --filter @unimetrics/api lint",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "cli": "pnpm --filter @unimetrics/cli start",
    "cli:help": "pnpm --filter @unimetrics/cli start --no-banner --help",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "commitlint:all": "commitlint --from $(git rev-list --max-parents=0 HEAD) --to HEAD",
    "commitlint:pr": "bash scripts/github/check-pr-commits.sh",
    "dev": "pnpm --filter @unimetrics/landing dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "fsd:check": "CHOKIDAR_USEPOLLING=1 steiger ./app/src && CHOKIDAR_USEPOLLING=1 steiger ./landing/src && CHOKIDAR_USEPOLLING=1 steiger ./mobile/src",
    "fsd:watch": "CHOKIDAR_USEPOLLING=1 steiger ./app/src --watch",
    "ios": "pnpm --filter @unimetrics/mobile ios",
    "lint": "pnpm -r lint && pnpm fsd:check",
    "lint:allow-scripts": "bash scripts/check-allow-scripts.sh",
    "lint:circular": "bash scripts/check-circular-deps.sh",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --cache --fix",
    "lint:knip": "knip --cache --include dependencies,files",
    "lint-staged": "lint-staged",
    "mobile": "pnpm --filter @unimetrics/mobile dev",
    "setup": "pnpm install && husky && pnpm allow-scripts",
    "syncpack:check": "syncpack list-mismatches && syncpack lint-semver-ranges",
    "syncpack:fix": "syncpack fix-mismatches && syncpack set-semver-ranges",
    "syncpack:list": "syncpack list",
    "test": "pnpm -r test",
    "web:mobile": "pnpm --filter @unimetrics/mobile web"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@eslint/js": "9.39.3",
    "@feature-sliced/steiger-plugin": "0.5.7",
    "@lavamoat/allow-scripts": "3.4.3",
    "@lavamoat/preinstall-always-fail": "2.1.1",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "8.56.1",
    "astro-eslint-parser": "1.3.0",
    "eslint": "9.39.3",
    "eslint-plugin-astro": "1.6.0",
    "eslint-plugin-jsdoc": "62.7.1",
    "eslint-plugin-no-secrets": "2.2.2",
    "eslint-plugin-perfectionist": "5.6.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-regexp": "3.0.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "knip": "5.85.0",
    "lint-staged": "16.3.2",
    "madge": "8.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-multiline-arrays": "4.1.4",
    "prettier-plugin-packagejson": "3.0.1",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "steiger": "0.5.11",
    "syncpack": "13.0.4",
    "typescript-eslint": "8.56.1"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  }
}
