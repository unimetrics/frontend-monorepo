{
  "name": "frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "commitlint:all": "commitlint --from $(git rev-list --max-parents=0 HEAD) --to HEAD",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "syncpack:check": "syncpack list-mismatches && syncpack lint-semver-ranges",
    "syncpack:fix": "syncpack fix-mismatches && syncpack set-semver-ranges",
    "syncpack:list": "syncpack list",
    "test": "pnpm -r test"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-multiline-arrays": "4.1.4",
    "prettier-plugin-packagejson": "3.0.0",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "syncpack": "13.0.4"
  }
}
