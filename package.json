{
  "name": "frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "allow-scripts:update": "allow-scripts auto",
    "build": "pnpm --filter @unimetrics/design-tokens build && pnpm --filter @unimetrics/landing build",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "commitlint:pr": "bash scripts/github/check-pr-commits/check-pr-commits.sh",
    "dev": "pnpm -r --parallel --filter @unimetrics/design-tokens --filter @unimetrics/landing dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lh:check": "pnpm -r --parallel --if-present lh:check",
    "lint": "pnpm -r --if-present lint",
    "lint:allow-scripts": "bash scripts/check-allow-scripts/check-allow-scripts.sh",
    "lint:circular": "bash scripts/check-circular-deps/check-circular-deps.sh",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --cache --fix",
    "lint:fsd": "CHOKIDAR_USEPOLLING=1 steiger ./app/src && CHOKIDAR_USEPOLLING=1 steiger ./landing/src && CHOKIDAR_USEPOLLING=1 steiger ./mobile/src",
    "lint:i18n": "pnpm -r --if-present lint:i18n",
    "lint:knip": "knip --cache --include dependencies,files",
    "lint:md-links": "remark \"**/*.md\" --frail --quiet && REMARK_MDX=1 remark \"**/*.mdx\" --frail --quiet",
    "lint:rulesets": "bash scripts/github/validate-rulesets/validate-rulesets.sh",
    "lint-staged": "lint-staged",
    "setup": "pnpm install && husky && pnpm allow-scripts",
    "syncpack:check": "syncpack list-mismatches && syncpack lint-semver-ranges",
    "syncpack:fix": "syncpack fix-mismatches && syncpack set-semver-ranges",
    "syncpack:list": "syncpack list"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.4",
    "@feature-sliced/steiger-plugin": "0.5.7",
    "@lavamoat/allow-scripts": "3.4.3",
    "@lavamoat/preinstall-always-fail": "2.1.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.59.1",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "8.59.1",
    "astro-eslint-parser": "1.4.0",
    "eslint": "9.39.4",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "knip": "5.88.1",
    "lint-staged": "16.4.0",
    "madge": "8.0.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-multiline-arrays": "4.1.7",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.0",
    "remark-cli": "12.0.1",
    "remark-mdx": "3.1.1",
    "remark-validate-links": "13.1.0",
    "steiger": "0.5.11",
    "syncpack": "13.0.4",
    "tsx": "4.21.0",
    "typescript-eslint": "8.59.1"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "tsx>esbuild": true
    }
  }
}
