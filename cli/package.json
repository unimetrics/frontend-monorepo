{
  "name": "@unimetrics/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lpdesk": "./dist/bin/lpdesk.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:deps": "pnpm --filter @unimetrics/api build",
    "dev": "pnpm run start -- --help",
    "start": "pnpm run build:deps && pnpm run build && node ./dist/bin/lpdesk.js",
    "test": "echo \"No tests configured\""
  },
  "dependencies": {
    "@unimetrics/api": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
